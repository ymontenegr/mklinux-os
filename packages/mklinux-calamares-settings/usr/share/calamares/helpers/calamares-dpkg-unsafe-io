#!/bin/sh
# Acelera dpkg durante la instalación (force-unsafe-io); con -u lo deshace.
# Igual que en calamares-settings-debian 13.0.13 (ISC).

CHROOT=$(mount | grep proc | grep calamares | awk '{print $3}' | sed -e "s#/proc##g")

if [ "$1" = "-u" ]; then
    rm "$CHROOT/etc/dpkg/dpkg.cfg.d/calamares-force-unsafe-io"
    sync
    exit 0
fi

echo "force-unsafe-io" > "$CHROOT/etc/dpkg/dpkg.cfg.d/calamares-force-unsafe-io"
exit 0
