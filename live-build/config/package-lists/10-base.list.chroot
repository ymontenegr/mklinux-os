# Base del sistema live. La ISO se construye sin paquetes recomendados:
# todo lo que debe ir en la imagen se declara en estas listas.

# Arranque y configuración de la sesión live (usuario, idioma, teclado)
live-boot
live-config
live-config-systemd

# Administración: sudo y polkit (permite al usuario gestionar red y discos)
sudo
polkitd

# Idioma y teclado de consola
locales
keyboard-configuration
console-setup

# Usuario live y herramientas de la sesión live (live-config los recomienda;
# sin user-setup el usuario mk no se crea)
user-setup
live-tools

# Seguridad y certificados: AppArmor y CA del sistema (HTTPS fuera de Firefox)
apparmor
ca-certificates

# Páginas de manual (comando man)
man-db

# Compresión, copia y sistemas de archivos de memorias USB
unzip
xz-utils
zstd
bzip2
rsync
ntfs-3g
dosfstools
exfatprogs
