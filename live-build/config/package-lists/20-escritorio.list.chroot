# Escritorio XFCE con LightDM.

# Escritorio y sesión gráfica
xfce4
xfce4-terminal
lightdm
lightdm-gtk-greeter
xserver-xorg-core
xserver-xorg-input-all
xserver-xorg-video-all

# Servicios de escritorio: agente polkit, discos y papelera, energía,
# notificaciones, accesibilidad, enlaces y carpetas de usuario
mate-polkit
gvfs
udisks2
thunar-volman
upower
xfce4-power-manager
xfce4-notifyd
libnotify-bin
at-spi2-core
xdg-utils
xdg-user-dirs

# Fuentes base de X e iconos
xfonts-base
tango-icon-theme

# Selección de xfce4-goodies: herramientas de uso diario
mousepad
ristretto
thunar-archive-plugin
xfce4-screenshooter
xfce4-taskmanager
xfce4-whiskermenu-plugin
xfce4-xkb-plugin
xfce4-clipman-plugin
xfce4-systemload-plugin

# Complementos de Thunar y del panel: gestor de archivos comprimidos (lo usa
# thunar-archive-plugin), miniaturas e indicador de batería
xarchiver
tumbler
xfce4-power-manager-plugins

# TLS para aplicaciones GTK/GIO y la orden gio (papelera, montajes desde la terminal)
glib-networking
libglib2.0-bin

# Aceleración de vídeo por hardware (Intel y AMD/Mesa)
intel-media-va-driver
i965-va-driver
mesa-va-drivers
mesa-vdpau-drivers
